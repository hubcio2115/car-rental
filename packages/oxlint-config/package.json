{
  "name": "@repo/oxlint-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared oxlint configuration for the Sentinel monorepo's library and node workspaces",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo"
  },
  "peerDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
