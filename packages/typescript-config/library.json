{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library",
  "extends": "./base.json",
  "compilerOptions": {
    /* If transpiling with TypeScript */
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "sourceMap": true,

    /* AND if building for a library */
    "declaration": true,

    /* AND if building for a library in a monorepo */
    "composite": true,
    "declarationMap": true,

    /* Code does not run in the DOM */
    "lib": ["ES2024"],

    /* Only Node's ambient types, never whatever else happens to be hoisted into node_modules */
    "types": ["node"]
  }
}
