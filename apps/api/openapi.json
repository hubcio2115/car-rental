                  "required": ["content", "page"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "List cars matching the given filters",
        "tags": ["Cars"]
      },
      "post": {
        "operationId": "CarController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1886,
                    "maximum": 2027
                  },
                  "registrationNumber": {
                    "type": "string"
                  },
                  "vin": {
                    "type": "string"
                  },
                  "seats": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9
                  },
                  "doors": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "pricePerDay": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMinimum": true,
                    "maximum": 99999999.99,
                    "multipleOf": 0.01
                  },
                  "type": {
                    "type": "string",
                    "enum": ["suv", "sedan", "van"]
                  }
                },
                "required": [
                  "model",
                  "year",
                  "registrationNumber",
                  "vin",
                  "seats",
                  "doors",
                  "pricePerDay",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "model": {
                      "type": "string"
                    },
                    "year": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "registrationNumber": {
                      "type": "string"
                    },
                    "vin": {
                      "type": "string",
                      "maxLength": 17
                    },
                    "seats": {
                      "type": "integer",
                      "minimum": -32768,
                      "maximum": 32767
                    },
                    "doors": {
                      "type": "integer",
                      "minimum": -32768,
                      "maximum": 32767
                    },
                    "pricePerDay": {
                      "type": "number",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "type": {
                      "type": "string",
                      "enum": ["suv", "sedan", "van"]
                    },
                    "status": {
                      "type": "string",
                      "enum": ["available", "rented"],
                      "description": "Derived: rented while a rental covers today"
                    }
                  },
                  "required": [
                    "id",
                    "model",
                    "year",
                    "registrationNumber",
                    "vin",
                    "seats",
                    "doors",
                    "pricePerDay",
                    "type",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Register a car",
        "tags": ["Cars"]
