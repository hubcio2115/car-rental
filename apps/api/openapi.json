    "/car/{carId}/rentals": {
      "post": {
        "operationId": "RentalController_rent",
        "parameters": [
          {
            "name": "carId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "maximum": 9007199254740991
