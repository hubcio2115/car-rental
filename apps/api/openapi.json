              "type": "array",
              "items": {
                "type": "string",
                "enum": ["suv", "sedan", "van"]
              }
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["available", "rented"]
              }
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.01
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.01
            }
          },
          {
            "name": "seats",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              }
            }
          },
          {
            "name": "doors",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            }
          },
          {
            "name": "minYear",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1886,
              "maximum": 2027
            }
          },
          {
            "name": "maxYear",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1886,
              "maximum": 2027
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "schema": {
              "default": 12,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "id,asc",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Car"
