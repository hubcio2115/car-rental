# development | production | test. Development seeds an empty fleet and serves Swagger at /api.
NODE_ENV=development

# Port the API listens on. apps/web expects 8080.
PORT=8080

# Matches the postgres service in docker/compose.yaml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/car_rental

BETTER_AUTH_SECRET=supersecret
BETTER_AUTH_URL=http://localhost:8080

# The web app. The only origin allowed to call the API with credentials (CORS) or change state (CSRF).
WEB_ORIGIN=http://localhost:3000
